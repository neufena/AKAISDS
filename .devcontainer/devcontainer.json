{
    "name": "AKAISDS build",
    "build": { "dockerfile": "Dockerfile" },
    "remoteUser": "vscode",
    // The uv and Nuitka caches are big and slow to recreate: keep them across rebuilds
    "mounts": [
        "source=akaisds-uv-cache,target=/home/vscode/.cache/uv,type=volume",
        "source=akaisds-nuitka-cache,target=/home/vscode/.cache/Nuitka,type=volume"
    ],
    // Named volumes are created root-owned
    "postCreateCommand": "sudo chown -R $(id -u):$(id -g) ~/.cache && uv sync",
    "customizations": {
        "vscode": {
            "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
        }
    }
}
